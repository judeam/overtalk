import { Theme, Icons } from "theme.slint";
import { ActionButton, Hint } from "widgets.slint";
export component MeetingWidget inherits Window {
    title: "Overtalk meeting controls";
    preferred-width: 350px; preferred-height: 175px;
    min-width: 300px; min-height: 160px;
    always-on-top: true;
    background: Theme.panel;
    in-out property <string> meeting-title: "Meeting detected";
    in-out property <string> description;
    in-out property <bool> recording;
    in-out property <bool> can-join;
    callback action(string);
    VerticalLayout { padding: 16px; spacing: 10px;
        HorizontalLayout { spacing: 10px;
            Image { source: Icons.brand; width: 20px; height: 20px; }
            Text { text: "Overtalk"; font-size: 15px; font-weight: 600; color: Theme.ink; }
            Rectangle { horizontal-stretch: 1; }
            if root.recording: Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.magenta; }
        }
        Text { text: root.meeting-title; font-size: 17px; font-weight: 600; color: Theme.ink; overflow: elide; }
        Hint { text: root.description; font-size: 12px; }
        HorizontalLayout { spacing: 8px;
            if root.can-join: ActionButton { text: "Join"; compact: true; clicked => { root.action("join"); } }
            ActionButton { text: root.recording ? "Stop recording" : "Record"; primary: true; compact: true; clicked => { root.action(root.recording ? "stop" : "record"); } }
            ActionButton { icon: Icons.library; help: "Open Overtalk"; compact: true; clicked => { root.action("open"); } }
        }
    }
}
