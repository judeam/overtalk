import { ScrollView } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { State } from "state.slint";
import { ActionButton, Hint, Divider, TextLink, SpeakerBadge } from "widgets.slint";

export component InspectorPanel inherits Rectangle {
    background: State.inspector-kind == "decision" && Theme.dark ? #1c2024 : Theme.panel;
    border-width: 1px; border-color: Theme.line; border-radius: 8px * Theme.scale;
    ScrollView {
        VerticalLayout {
            padding: 20px * Theme.scale; spacing: 16px * Theme.scale;
            HorizontalLayout {
                Text { text: State.inspector-title; color: State.inspector-kind == "decision" ? Theme.amber : State.inspector-kind == "action" ? Theme.violet : Theme.teal; font-size: 15px * Theme.scale; font-weight: 600; vertical-alignment: center; wrap: word-wrap; }
                Rectangle { horizontal-stretch: 1; }
                ActionButton { icon: Icons.more; help: "Selected moment options"; width: 24px * Theme.scale; height: 24px * Theme.scale; flat: true; compact: true; clicked => { State.action("meeting-options", ""); } }
            }
            if State.inspector-kind != "transcript": Hint { text: "From the notes · review the source"; color: Theme.muted; font-size: 12px * Theme.scale; }
            Text { text: State.inspector-body; font-size: 19px * Theme.scale; color: Theme.ink; wrap: word-wrap; line-height-factor: 1.3; }
            for source in State.inspector-evidence: VerticalLayout {
                spacing: 7px * Theme.scale;
                HorizontalLayout {
                    TextLink { text: source.title; font-size: 12px * Theme.scale; clicked => { State.action("seek-absolute", source.id); } }
                    Rectangle { horizontal-stretch: 1; }
                }
                Hint { text: "“" + source.description + "”"; font-size: 14px * Theme.scale; line-height-factor: 1.3; }
            }
            if State.inspector-owner != "": HorizontalLayout {
                spacing: 10px * Theme.scale;
                Hint { text: "Said by"; color: Theme.muted; }
                SpeakerBadge { width: 18px * Theme.scale; tone: State.inspector-tone; }
                Text { text: State.inspector-owner; color: Theme.ink; font-size: 14px * Theme.scale; font-weight: 600; }
                Rectangle { horizontal-stretch: 1; }
            }
            Divider { }
            HorizontalLayout {
                spacing: 8px * Theme.scale;
                ActionButton { text: "Play from " + State.inspector-stamp; icon: Icons.play; primary: true; compact: true; height: 40px * Theme.scale; label-size: 14px * Theme.scale; background: Theme.dark ? #76d5ce : #087777; foreground: Theme.dark ? #0c2929 : #ffffff; clicked => { State.action("play-selection", ""); } }
                ActionButton { text: "Copy"; icon: Icons.copy; compact: true; flat: true; height: 40px * Theme.scale; border-width: 1px; border-color: Theme.line-strong; clicked => { State.action("copy-selection", ""); } }
                Rectangle { horizontal-stretch: 1; }
            }
            Divider { }
            Text { text: "Context"; color: Theme.ink; font-size: 14px * Theme.scale; font-weight: 600; }
            for label[index] in ["In the meeting", "Date", "Speakers"]: HorizontalLayout {
                spacing: 12px * Theme.scale;
                Hint { text: label; width: 74px * Theme.scale; font-size: 12px * Theme.scale; color: Theme.muted; }
                Hint { text: [State.title, State.meeting-date, State.meeting-people][index]; font-size: 13px * Theme.scale; }
            }
            if State.meeting-notice != "": HorizontalLayout {
                spacing: 12px * Theme.scale;
                Hint { text: "Notice"; width: 74px * Theme.scale; font-size: 12px * Theme.scale; color: Theme.muted; }
                Hint { text: State.meeting-notice; font-size: 13px * Theme.scale; }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }
}
