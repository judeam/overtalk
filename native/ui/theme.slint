export global Theme {
    in-out property <bool> dark: true;
    in-out property <float> scale: 1;
    out property <length> body: 18px * scale;
    out property <length> small: 14px * scale;
    out property <length> title: 30px * scale;
    out property <color> ground: dark ? #0f1318 : #f1f4f6;
    out property <color> chrome: dark ? #12171d : #f3f6f8;
    out property <color> rail: dark ? #11161c : #fafcfd;
    out property <color> panel: dark ? #161b22 : #ffffff;
    out property <color> raised: dark ? #222a34 : #e8ecef;
    out property <color> line: dark ? #232a33 : #e1e6ea;
    out property <color> line-strong: dark ? #323b46 : #cfd6dc;
    out property <color> ink: dark ? #e8ecf0 : #151a21;
    out property <color> secondary: dark ? #b8c1cc : #3c4552;
    out property <color> muted: dark ? #8d97a3 : #5f6977;
    out property <color> primary: teal;
    out property <color> danger: dark ? #ff8a92 : #af2433;
    out property <color> on-primary: dark ? #0f1318 : #ffffff;
    out property <color> selection: dark ? #1f2833 : #e9eff5;
    out property <color> teal: dark ? #69d1ca : #087777;
    out property <color> magenta: dark ? #ee74a0 : #c42e64;
    out property <color> amber: dark ? #efc565 : #835d00;
    out property <color> violet: dark ? #bb9ae7 : #7751a0;
    out property <color> record: #f0483f;
}

export global Icons {
    out property <image> home: @image-url("../assets/home.svg");
    out property <image> folder: @image-url("../assets/folder.svg");
    out property <image> link: @image-url("../assets/link.svg");
    out property <image> history: @image-url("../assets/history.svg");
    out property <image> shield: @image-url("../assets/shield.svg");
    out property <image> bookmark: @image-url("../assets/bookmark.svg");
    out property <image> person: @image-url("../assets/person.svg");
    out property <image> sliders: @image-url("../assets/sliders.svg");
    out property <image> brand: Theme.dark ? @image-url("../assets/brand-dark.svg") : @image-url("../assets/brand-light.svg");
    out property <image> notes: @image-url("../assets/notes.svg");
    out property <image> speakers: @image-url("../assets/speakers.svg");
    out property <image> gear: @image-url("../assets/gear.svg");
    out property <image> calendar: @image-url("../assets/calendar.svg");
    out property <image> audio: @image-url("../assets/audio.svg");
    out property <image> drive: @image-url("../assets/drive.svg");
    out property <image> system: @image-url("../assets/system.svg");
    out property <image> chevron-up: @image-url("../assets/chevron-up.svg");
    out property <image> chevron-right: @image-url("../assets/chevron-right.svg");
    out property <image> chevron: @image-url("../assets/chevron.svg");
    out property <image> tasks: @image-url("../assets/tasks.svg");
    out property <image> transcript: @image-url("../assets/transcript.svg");
    out property <image> arrow: @image-url("../assets/arrow.svg");
    out property <image> microphone: @image-url("../assets/microphone.svg");
    out property <image> library: @image-url("../assets/library.svg");
    out property <image> search: @image-url("../assets/search.svg");
    out property <image> settings: @image-url("../assets/settings.svg");
    out property <image> upload: @image-url("../assets/upload.svg");
    out property <image> play: @image-url("../assets/play.svg");
    out property <image> pause: @image-url("../assets/pause.svg");
    out property <image> stop: @image-url("../assets/stop.svg");
    out property <image> back: @image-url("../assets/back.svg");
    out property <image> forward: @image-url("../assets/forward.svg");
    out property <image> trash: @image-url("../assets/trash.svg");
    out property <image> copy: @image-url("../assets/copy.svg");
    out property <image> download: @image-url("../assets/download.svg");
    out property <image> share: @image-url("../assets/share.svg");
    out property <image> check: @image-url("../assets/check.svg");
    out property <image> more: @image-url("../assets/more.svg");
    out property <image> help: @image-url("../assets/help.svg");
    out property <image> close: @image-url("../assets/close.svg");
    out property <image> menu: @image-url("../assets/menu.svg");
    out property <image> edit: @image-url("../assets/edit.svg");
    out property <image> plus: @image-url("../assets/plus.svg");
}
