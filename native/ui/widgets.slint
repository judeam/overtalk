import { State } from "state.slint";
import { Theme, Icons } from "theme.slint";

// Stable footprint and state-driven feedback, with no continuous pulse.
export component SpeakerBadge inherits Rectangle {
    in property <color> tone: Theme.teal;
    in property <image> icon: Icons.person;
    in property <color> symbol-color: #ffffff;
    in property <bool> active: false;
    width: 20px * Theme.scale;
    height: self.width;
    border-radius: 4px * Theme.scale;
    background: tone;
    Image { source: root.icon; colorize: root.symbol-color; width: parent.width * 0.72; height: self.width; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
    Rectangle {
        x: -3px * Theme.scale; y: self.x;
        width: parent.width + 6px * Theme.scale; height: self.width;
        border-width: 1px; border-color: root.tone; border-radius: 7px * Theme.scale;
        opacity: root.active ? 0.65 : 0;
        animate opacity { duration: State.reduced-motion ? 0ms : 160ms; easing: cubic-bezier(0.23, 1, 0.32, 1); }
    }
}

export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <string> help: text;
    in property <image> icon;
    in property <bool> primary: false;
    in property <color> accent: Theme.primary;
    in property <bool> destructive: false;
    in property <bool> flat: false;
    in property <bool> selected: false;
    in property <color> selected-background: Theme.selection;
    property <bool> keyboard-focus: false;
    in property <bool> enabled: true;
    in property <bool> compact: false;
    in property <bool> left-aligned: false;
    in property <color> foreground: primary ? Theme.on-primary : destructive ? Theme.danger : selected ? Theme.teal : Theme.secondary;
    in property <angle> icon-rotation: 0deg;
    in property <length> icon-size: 1.15 * label-size;
    in property <bool> preserve-icon-colors: false;
    in property <int> label-weight: primary ? 500 : 400;
    in property <length> horizontal-padding: 10px * Theme.scale;
    in property <length> label-size: compact ? 14px * Theme.scale : 18px * Theme.scale;
    callback clicked();
    public function focus-control() { focus.focus(); }
    horizontal-stretch: 0;
    min-width: icon.width > 0 && text == "" ? 32px * Theme.scale : label.preferred-width + 2 * horizontal-padding + (icon.width > 0 ? icon-size + 7px * Theme.scale : 0px);
    height: (compact ? 36px : 46px) * Theme.scale;
    border-radius: 6px;
    background: primary ? (touch.pressed ? accent.darker(0.2) : touch.has-hover ? accent.darker(0.1) : accent) : selected ? selected-background : touch.pressed ? Theme.raised : touch.has-hover ? Theme.selection : flat ? transparent : Theme.raised;
    animate background { duration: State.reduced-motion ? 0ms : 120ms; easing: cubic-bezier(0.23, 1, 0.32, 1); }
    border-width: focus.has-focus && keyboard-focus ? 2px : 0px;
    border-color: Theme.ink;
    opacity: enabled ? 1 : 0.5;
    accessible-role: button;
    accessible-label: help;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { root.clicked(); } }
    HorizontalLayout {
        padding-left: root.horizontal-padding;
        padding-right: root.horizontal-padding;
        spacing: 7px * Theme.scale;
        alignment: root.left-aligned ? start : center;
        if root.icon.width > 0: Rectangle {
            width: root.icon-size;
            if !root.preserve-icon-colors: Image {
                source: root.icon;
                transform-rotation: root.icon-rotation;
                width: parent.width;
                height: self.width;
                y: (parent.height - self.height) / 2;
                colorize: root.foreground;
            }
            if root.preserve-icon-colors: Image { source: root.icon; width: parent.width; height: self.width; y: (parent.height - self.height) / 2; }
        }
        label := Text {
            text: root.text;
            color: root.foreground;
            font-size: root.label-size;
            font-weight: root.label-weight;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(event) => { if event.kind == PointerEventKind.down { focus.focus(); } }
        clicked => { root.clicked(); }
    }

    focus := FocusScope {
        focus-on-click: false;
        focus-gained(reason) => { root.keyboard-focus = reason == FocusReason.tab-navigation; }
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.clicked(); return accept; }
            return reject;
        }
    }
}

export component Field inherits Rectangle {
    public function focus-control() { input.focus(); }
    in property <string> placeholder;
    in property <string> accessible-name: placeholder;
    in property <bool> password: false;
    in property <bool> enabled: true;
    in property <image> icon;
    in property <length> text-size: Theme.body;
    in-out property <string> text <=> input.text;
    callback edited(string);
    callback accepted(string);
    height: 42px * Theme.scale;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.teal : Theme.line;
    border-radius: 6px;
    background: Theme.ground;
    accessible-role: text-input;
    accessible-label: root.accessible-name;
    accessible-value: password ? "" : text;
    if icon.width > 0: Image {
        x: 10px * Theme.scale;
        y: (parent.height - self.height) / 2;
        width: 18px * Theme.scale;
        height: self.width;
        source: root.icon;
        colorize: Theme.muted;
    }
    if text == "": Text {
        x: (root.icon.width > 0 ? 34px : 12px) * Theme.scale;
        width: parent.width - self.x - 12px * Theme.scale;
        text: root.placeholder;
        color: Theme.muted;
        font-size: root.text-size;
        vertical-alignment: center;
    }
    input := TextInput {
        x: (root.icon.width > 0 ? 34px : 12px) * Theme.scale;
        width: parent.width - self.x - 12px * Theme.scale;
        height: parent.height;
        color: Theme.ink;
        font-size: root.text-size;
        vertical-alignment: center;
        selection-background-color: Theme.selection;
        selection-foreground-color: Theme.ink;
        input-type: root.password ? InputType.password : InputType.text;
        enabled: root.enabled;
        single-line: true;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(self.text); }
    }

    forward-focus: input;
}

export component SectionHeading inherits Text {
    color: Theme.ink;
    font-size: Theme.title;
    font-weight: 600;
    wrap: word-wrap;
}

export component Hint inherits Text {
    color: Theme.secondary;
    font-size: Theme.small;
    wrap: word-wrap;
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.line;
}

export component TextLink inherits Text {
    horizontal-stretch: 0;
    callback clicked();
    color: Theme.ink;
    font-size: 12px * Theme.scale;
    height: 19.2px * Theme.scale;
    vertical-alignment: center;
    accessible-role: button;
    accessible-label: self.text;
    accessible-action-default => { root.clicked(); }
    Rectangle { height: 1px; y: parent.height - 2px * Theme.scale; width: parent.width; background: Theme.line-strong; }
    TouchArea { mouse-cursor: pointer; pointer-event(event) => { if event.kind == PointerEventKind.down { focus.focus(); } }
        clicked => { root.clicked(); } }
    focus := FocusScope {
        focus-on-click: false; key-pressed(event) => { if event.text == " " || event.text == "\n" { root.clicked(); return accept; } return reject; } }
}

export component SourceButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    callback clicked();
    horizontal-stretch: 0;
    min-width: label.preferred-width + 74px * Theme.scale;
    height: 40px * Theme.scale;
    HorizontalLayout {
        padding: 12px * Theme.scale;
        spacing: 10px * Theme.scale;
        Rectangle { width: 14.95px * Theme.scale;
            Image { source: root.icon; width: parent.width; height: self.width; y: (parent.height - self.height) / 2; colorize: Theme.secondary; }
        }
        label := Text { text: root.text; color: Theme.secondary; font-size: 13px * Theme.scale; vertical-alignment: center; }
        Rectangle { width: 14.95px * Theme.scale;
            Image { source: @image-url("../assets/chevron.svg"); width: parent.width; height: self.width; y: (parent.height - self.height) / 2; colorize: Theme.secondary; }
        }
    }
    TouchArea { mouse-cursor: pointer; pointer-event(event) => { if event.kind == PointerEventKind.down { focus.focus(); } } clicked => { root.clicked(); } }
    focus := FocusScope { focus-on-click: false; key-pressed(event) => { if event.text == " " || event.text == "\n" { root.clicked(); return accept; } return reject; } }
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }
}

export component ReviewTab inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> selected: false;
    callback clicked();
    horizontal-stretch: 0;
    in property <length> label-size: 15px * Theme.scale;
    min-width: label.preferred-width + (root.icon.width > 0 ? 24.25px : 0px) * Theme.scale;
    height: 48px * Theme.scale;
    HorizontalLayout {
        spacing: 7px * Theme.scale;
        alignment: center;
        Rectangle { width: 17.25px * Theme.scale;
            Image { source: root.icon; width: parent.width; height: self.width; y: (parent.height - self.height) / 2; colorize: root.selected ? Theme.teal : Theme.muted; }
        }
        label := Text { text: root.text; color: root.selected ? Theme.teal : Theme.muted; font-size: root.label-size; font-weight: root.selected ? 600 : 400; vertical-alignment: center; }
    }
    if selected: Rectangle { x: 0; y: root.height - self.height; height: 2px * Theme.scale; width: root.width; background: Theme.teal; }
    TouchArea { mouse-cursor: pointer; pointer-event(event) => { if event.kind == PointerEventKind.down { focus.focus(); } }
        clicked => { root.clicked(); } }
    focus := FocusScope {
        focus-on-click: false; key-pressed(event) => { if event.text == " " || event.text == "\n" { root.clicked(); return accept; } return reject; } }
}

export component CheckControl inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    in property <length> label-size: 13px * Theme.scale;
    callback toggled(bool);
    horizontal-stretch: 0;
    min-width: label.preferred-width + 23px * Theme.scale;
    height: 32px * Theme.scale;
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checked: root.checked;
    accessible-action-default => { root.checked = !root.checked; root.toggled(root.checked); }
    Rectangle {
        x: 0; y: (parent.height - self.height) / 2;
        width: 16px * Theme.scale; height: self.width;
        background: root.checked ? Theme.ink : Theme.ground;
        border-width: 1px; border-color: root.checked ? Theme.ink : Theme.muted; border-radius: 2px;
        if root.checked: Image { source: @image-url("../assets/check.svg"); width: parent.width; height: parent.height; colorize: Theme.ground; }
    }
    label := Text { x: 23px * Theme.scale; height: parent.height; text: root.text; color: Theme.secondary; font-size: root.label-size; vertical-alignment: center; }
    TouchArea { mouse-cursor: pointer; pointer-event(event) => { if event.kind == PointerEventKind.down { focus.focus(); } }
        clicked => { root.checked = !root.checked; root.toggled(root.checked); } }
    focus := FocusScope {
        focus-on-click: false; key-pressed(event) => { if event.text == " " { root.checked = !root.checked; root.toggled(root.checked); return accept; } return reject; } }
}

export component ChoiceControl inherits Rectangle {
    in property <bool> enabled: true;
    in property <[string]> model;
    in property <image> icon;
    in-out property <int> current-index: 0;
    callback selected(int);
    height: 36px * Theme.scale;
    min-width: 68px * Theme.scale;
    horizontal-stretch: 0;
    background: Theme.panel; border-width: 1px; border-color: Theme.line-strong; border-radius: 6px * Theme.scale;
    accessible-role: combobox;
    accessible-value: model[current-index];
    accessible-expandable: true;
    accessible-action-expand => { if root.enabled { popup.show(); } }
    opacity: root.enabled ? 1 : 0.55;
    if icon.width > 0: Image { source: root.icon; x: 8px * Theme.scale; width: 17px * Theme.scale; height: self.width; y: (parent.height - self.height) / 2; colorize: Theme.secondary; }
    Text { x: (root.icon.width > 0 ? 32px : 8px) * Theme.scale; width: parent.width - self.x - 20px * Theme.scale; height: parent.height; text: root.model[root.current-index]; color: Theme.ink; font-size: 14px * Theme.scale; vertical-alignment: center; overflow: elide; }
    Image { x: parent.width - 18px * Theme.scale; y: (parent.height - self.height) / 2; width: 12px * Theme.scale; height: self.width; source: @image-url("../assets/chevron.svg"); colorize: Theme.secondary; }
    TouchArea { enabled: root.enabled; mouse-cursor: pointer; pointer-event(event) => { if event.kind == PointerEventKind.down { focus.focus(); } }
        clicked => { popup.show(); } }
    focus := FocusScope {
        focus-on-click: false; key-pressed(event) => { if root.enabled && (event.text == " " || event.text == Key.DownArrow) { popup.show(); return accept; } return reject; } }
    popup := PopupWindow {
        x: 0; y: root.height;
        width: max(root.width, 96px * Theme.scale);
        height: root.model.length * 32px * Theme.scale + 8px * Theme.scale;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.panel; border-width: 1px; border-color: Theme.line-strong; border-radius: 6px * Theme.scale;
            VerticalLayout {
                padding: 4px * Theme.scale; spacing: 0px;
                for value[index] in root.model: ActionButton { text: value; compact: true; flat: true; left-aligned: true; selected: root.current-index == index; height: 32px * Theme.scale; clicked => { root.current-index = index; root.selected(index); popup.close(); } }
            }
        }
    }
}

export component TrackSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in-out property <float> value: 50;
    callback changed();
    width: 90px * Theme.scale; height: 24px * Theme.scale;
    Rectangle { x: 0; y: (parent.height - self.height) / 2; width: parent.width; height: 4px * Theme.scale; border-radius: self.height / 2; background: Theme.muted.darker(0.5); }
    Rectangle { x: 0; y: (parent.height - self.height) / 2; width: parent.width * (root.value - root.minimum) / (root.maximum - root.minimum); height: 4px * Theme.scale; border-radius: self.height / 2; background: Theme.ink; }
    Rectangle { x: (parent.width - self.width) * (root.value - root.minimum) / (root.maximum - root.minimum); y: (parent.height - self.height) / 2; width: 13px * Theme.scale; height: self.width; border-radius: self.width / 2; background: Theme.ink; }
    area := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => { if event.kind == PointerEventKind.down { focus.focus(); root.value = root.minimum + min(1, max(0, self.mouse-x / self.width)) * (root.maximum - root.minimum); root.changed(); } }
        moved => { if self.pressed { root.value = root.minimum + min(1, max(0, self.mouse-x / self.width)) * (root.maximum - root.minimum); root.changed(); } }
    }
    focus := FocusScope {
        focus-on-click: false; key-pressed(event) => { if event.text == Key.LeftArrow || event.text == Key.RightArrow { root.value = min(root.maximum, max(root.minimum, root.value + (event.text == Key.LeftArrow ? -10 : 10))); root.changed(); return accept; } return reject; } }
}

export component PageHeading inherits Text {
    color: Theme.ink;
    font-size: min(44px * Theme.scale, max(30px * Theme.scale, 0.023px * State.window-width));
    font-weight: 650;
    letter-spacing: -0.035 * self.font-size;
    height: 1.15 * self.font-size;
    vertical-alignment: center;
}

export component ReadingChoice inherits Rectangle {
    in property <string> text;
    in property <string> description;
    in property <bool> checked;
    callback clicked();
    height: max(44px * Theme.scale, labels.preferred-height + 6px * Theme.scale);
    Rectangle {
        x: 0px; y: (parent.height - self.height) / 2; width: 17px * Theme.scale; height: self.width;
        border-radius: self.width / 2; border-width: 1px; border-color: root.checked ? Theme.ink : Theme.muted;
        if root.checked: Rectangle { x: 4px * Theme.scale; y: self.x; width: parent.width - 8px * Theme.scale; height: self.width; border-radius: self.width / 2; background: Theme.ink; }
    }
    labels := VerticalLayout {
        x: 29px * Theme.scale; width: parent.width - self.x;
        alignment: center; spacing: 3px * Theme.scale;
        Text { text: root.text; color: Theme.ink; font-size: 14px * Theme.scale; font-weight: 500; }
        Hint { text: root.description; color: Theme.muted; font-size: 12px * Theme.scale; }
    }
    TouchArea { mouse-cursor: pointer; pointer-event(event) => { if event.kind == PointerEventKind.down { focus.focus(); } } clicked => { root.clicked(); } }
    focus := FocusScope { focus-on-click: false; key-pressed(event) => { if event.text == " " { root.clicked(); return accept; } return reject; } }
    accessible-role: radio-button;
    accessible-label: text;
    accessible-checked: checked;
    accessible-action-default => { root.clicked(); }
}

export component SwitchControl inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);
    width: 36px * Theme.scale; height: 20px * Theme.scale;
    border-radius: self.height / 2;
    background: checked ? Theme.teal : Theme.line-strong;
    animate background { duration: State.reduced-motion ? 0ms : 120ms; easing: cubic-bezier(0.23, 1, 0.32, 1); }
    Rectangle { x: (root.checked ? 18px : 2px) * Theme.scale; y: 2px * Theme.scale; width: 16px * Theme.scale; height: self.width; border-radius: self.width / 2; background: root.checked ? Theme.ground : Theme.muted;
        animate x { duration: State.reduced-motion ? 0ms : 160ms; easing: cubic-bezier(0.23, 1, 0.32, 1); }
    }
    TouchArea { mouse-cursor: pointer; pointer-event(event) => { if event.kind == PointerEventKind.down { focus.focus(); } } clicked => { root.checked = !root.checked; root.toggled(root.checked); } }
    focus := FocusScope { focus-on-click: false; key-pressed(event) => { if event.text == " " { root.checked = !root.checked; root.toggled(root.checked); return accept; } return reject; } }
    accessible-role: switch;
    accessible-checked: checked;
    accessible-action-default => { root.checked = !root.checked; root.toggled(root.checked); }
}
