    in-out property <int> guide-index: 0;
    in-out property <int> guide-return-view: 0;
    in-out property <int> guide-read-count: 0;
    in-out property <string> guide-title;
    in-out property <string> guide-summary;
    in-out property <string> guide-tip;
    in-out property <string> guide-keys;
    in-out property <string> guide-action-label;
    in-out property <bool> guide-is-read: false;
    in-out property <int> guide-revision: 0;
    in-out property <string> connection-provider;
    in-out property <bool> connection-busy: false;
    in-out property <bool> connection-browser: false;
    in-out property <bool> connection-google-ready: false;
    in-out property <bool> connection-ready: false;
    in-out property <string> connection-filter;
    in-out property <string> connection-code;
    in-out property <string> connection-attempt;
    in-out property <bool> watch-enabled: false;
    in-out property <bool> video-enabled: false;
    in-out property <bool> has-video: false;
    in-out property <bool> video-recording: false;
    in-out property <bool> video-starting: false;
    in-out property <bool> widget-visible: false;
    in-out property <string> widget-title;
    in-out property <string> widget-description;
    in-out property <string> widget-url;
    callback widget-updated();
    changed widget-visible => { self.widget-updated(); }
    changed widget-title => { self.widget-updated(); }
    changed widget-description => { self.widget-updated(); }
    changed widget-url => { self.widget-updated(); }
    in-out property <[string]> project-names;
    in-out property <int> project-index: 0;
