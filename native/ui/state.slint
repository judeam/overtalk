    in-out property <string> speech-model: "Local speech";
    in-out property <string> summary-model: "Local AI";
    in-out property <string> selected-template: "Meeting notes";
    in-out property <string> provider;
    in-out property <bool> cloud-available: false;
    in-out property <bool> cloud-connected: false;
    in-out property <bool> cloud-can-use: false;
    in-out property <bool> cloud-loading: false;
    in-out property <string> cloud-balance;
    in-out property <string> cloud-recovery;
    in-out property <string> cloud-held;
    // Private summaries: the account's route ("end-to-end" or the legacy "gateway").
    in-out property <bool> cloud-end-to-end: false;
    in-out property <string> cloud-notice: "Cloud plans are not available yet. Your local models and personal provider connections keep working.";
    in-out property <string> model;
    in-out property <string> endpoint;
    in-out property <string> api-key;
    in-out property <string> folder;
    // Recording notice: the step before capture and the open meeting's record.
    // `recording-notice-route` is local or external; `meeting-notice` is empty without a record.
    in-out property <string> recording-notice-text;
    in-out property <string> recording-notice-route;
    in-out property <string> recording-notice-detail;
    in-out property <string> meeting-notice;
    // Share a copy: kind 0 is a page, 1 an .overtalk file. Audio 0 is source clips
    // (pages) or the original recording (files), 1 the whole recording made smaller,
    // 2 none. Terms and time ranges are what the copy hides; the estimate is its size.
    in-out property <int> share-kind: 0;
    in-out property <int> share-audio: 0;
    in-out property <string> share-terms;
    in-out property <bool> share-contacts: false;
    in-out property <bool> share-omit-notes: false;
    in-out property <string> share-ranges;
    in-out property <string> share-estimate;
}
