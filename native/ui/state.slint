export struct MeetingRow { id: string, title: string, subtitle: string, pinned: bool }
export struct TranscriptRow { id: string, stamp: string, speaker: string, body: string, translation: string, tone: color, ink: color }
export struct NoteTableRow { cells: [string] }
export struct NoteBlock { id: int, kind: int, text: string, rich: styled-text, table: [NoteTableRow] }
export struct NoteHighlight { id: string, body: string, stamp: string, kind: int }
export struct ClipRow { id: string, label: string, body: string, start: float, end: float, position: float, span: float, members: string, count: int }
export struct TickRow { position: float, label: string }
export struct LaneRow { id: string, name: string, tone: color, waveform: image, kind: int, solo: bool, muted: bool, clips: [ClipRow] }
export struct ResultRow { id: string, title: string, subtitle: string, body: string, group-title: string, kind: string, stamp: string }
export struct DetailRow { id: string, title: string, description: string, value: string, checked: bool }
export struct FormRow { key: string, label: string, value: string, kind: int }
export struct TemplateSectionRow { index: int, title: string, instruction: string, format: int, item-format: string }
export struct GuideChapter { index: int, title: string, summary: string, group: string, starts-group: bool, read: bool }
export struct GuideStep { title: string, body: string }
// `project` is the display label; `project-state` is manual, automatic, suggested or empty.
export struct EventCard { id: string, title: string, description: string, provider: string, joinable: bool, project: string, project-state: string, reason: string, brief: string }
// `source` indexes the controller's brief sources; empty when an item has none.
export struct BriefItem { text: string, source: string, source-label: string }
export struct BriefSection { title: string, items: [BriefItem] }

export global State {
    in-out property <bool> recording-setup: false;
    in-out property <bool> search-focus: false;
    in-out property <string> choice-query;
    in-out property <int> choice-total: 0;
    in-out property <int> choice-height: 0;
    in-out property <[EventCard]> upcoming-meetings;
    in-out property <bool> edition-auto-assign: false;
    in-out property <bool> edition-briefs: false;
    in-out property <string> edition-name: "Open edition";
    in-out property <string> edition-detail;
