    in-out property <bool> reading-ready: false;
    in-out property <bool> reduced-motion: false;
    in-out property <int> motion-mode: 0;
    in-out property <bool> system-reduced-motion: false;
    in-out property <string> speaking-id;
    callback action(string, string);
    callback ui-style-changed();
    callback preferences-changed();
    in-out property <bool> auto-summary: true;
    in-out property <string> default-summary-language: "auto";
    in-out property <string> summary-template-id: "standard_meeting";
    changed auto-summary => { self.preferences-changed(); }
    changed default-summary-language => { self.preferences-changed(); }
    changed summary-template-id => { self.preferences-changed(); }
    changed dark => { self.preferences-changed(); }
    changed zoom => { self.preferences-changed(); }
    changed reading-size => { self.preferences-changed(); }
    changed motion-mode => { self.preferences-changed(); }
    changed timeline-open => { self.preferences-changed(); }
    changed notes-timeline-fraction => { self.preferences-changed(); }
    changed notes-highlights-open => { self.preferences-changed(); }
    changed close-to-tray => { self.preferences-changed(); }
    callback notes-edited(string);
    callback form-edited(string, string);
    pure callback note-group-contains(string, string) -> bool;
    pure callback matches-setting(string, string) -> bool;
    in-out property <float> window-width: 1440;
    in-out property <float> window-height: 900;
    in-out property <int> view: 0;
    in-out property <int> meeting-tab: 0;
    in-out property <int> settings-tab: 0;
    in-out property <string> privacy-summary: "Checking privacy controls…";
    in-out property <bool> privacy-encrypted: false;
    in-out property <int> privacy-pending: 0;
    in-out property <int> privacy-credentials: 0;
    in-out property <string> settings-query;
