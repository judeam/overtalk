    in-out property <bool> busy: false;
    in-out property <bool> notes-generating: false;
    in-out property <bool> transcribing: false;
    in-out property <bool> playing: false;
    in-out property <bool> recording: false;
    in-out property <bool> close-to-tray: false;
    callback recording-state-changed();
    changed recording => { self.recording-state-changed(); self.widget-updated(); }
    changed recording-paused => { self.recording-state-changed(); }
    in-out property <bool> recording-paused: false;
    in-out property <bool> recording-save-pending: false;
    in-out property <bool> timeline-open: true;
    in-out property <bool> dark: true;
