    in-out property <string> capture-project: "No project";
    in-out property <string> capture-project-detail;
    in-out property <string> capture-project-state;
    in-out property <string> brief-summary;
    in-out property <string> brief-note;
    // A note about missing talking points leads; a note about finished ones follows them.
    in-out property <bool> brief-note-first: true;
    in-out property <[BriefSection]> brief-sections;
    in-out property <[BriefItem]> brief-agenda;
    in-out property <int> automation-assign: 0;
    in-out property <int> automation-briefs: 0;
    in-out property <int> automation-reminder: 2;
    in-out property <[string]> automation-reminders: ["Off", "5 minutes before", "10 minutes before", "15 minutes before"];
    in-out property <bool> autostart-available: false;
    in-out property <bool> autostart: false;
    // A toast action applies only while the toast shows the message it was set for.
    in-out property <string> message-action-for;
    in-out property <string> message-action-label;
    in-out property <string> message-action;
    in-out property <string> message-action-value;
    in-out property <string> list-filter-label: "MEETINGS";
    in-out property <bool> calendar-syncing: false;
    in-out property <string> calendar-status: "Connect Google or Microsoft to see your next meetings.";
    in-out property <bool> calendar-connected: false;
    in-out property <bool> setup-checking: false;
    in-out property <bool> setup-speech-ready: false;
    in-out property <bool> setup-notes-ready: false;
    // Model downloads started from the setup checklist; recording may begin meanwhile.
    in-out property <bool> setup-speech-downloading: false;
    in-out property <bool> setup-notes-downloading: false;
    in-out property <string> setup-speech-detail: "Check the speech runtime and downloaded model.";
    in-out property <string> setup-notes-detail: "Choose a notes model, then check readiness.";
    in-out property <bool> setup-audio-confirmed: false;
    in-out property <bool> setup-test-done: false;
    in-out property <string> setup-audio-detail: "Record a sound check, then listen for yourself and the call.";
    changed setup-audio-confirmed => { self.preferences-changed(); }
    in-out property <string> personal-notes;
    in-out property <string> personal-status: "Saved on this device";
    in-out property <string> completion-status;
    in-out property <bool> completion-retry: false;
    in-out property <int> companion-tab: 0;
    in-out property <bool> companion-open: false;
    in-out property <string> assist-query;
