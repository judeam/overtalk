    // Settings → Automation: a setup command per AI assistant, while CLI or MCP access is on.
    in-out property <bool> assistants-on: false;
    in-out property <[DetailRow]> assistant-commands;
    in-out property <[string]> templates;
    in-out property <[string]> mic-devices;
    in-out property <[string]> system-devices;
