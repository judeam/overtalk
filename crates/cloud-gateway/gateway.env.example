# Server-only configuration. Never package this file with the desktop.
OVERTALK_CLOUD_ENABLED=false
OVERTALK_PRIVATEMODE_APPROVAL_REFERENCE=
OVERTALK_CLOUD_BIND=127.0.0.1:8095
OVERTALK_CLOUD_PUBLIC_URL=https://cloud.example.com
OVERTALK_CLOUD_DATABASE=/var/lib/overtalk-cloud/credits.sqlite
OVERTALK_STRIPE_LIVE=false
OVERTALK_STRIPE_KEY_FILE=/run/secrets/stripe-key
OVERTALK_STRIPE_WEBHOOK_FILE=/run/secrets/stripe-webhook
OVERTALK_STRIPE_LIFETIME_PRICE=price_replace_one_time
OVERTALK_STRIPE_MONTHLY_PRICE=price_replace_monthly
OVERTALK_STRIPE_TOPUP_PRICE=price_replace_credit_pack
OVERTALK_PRIVATEMODE_PROXY=http://127.0.0.1:8080/v1/
# Omit when the official proxy owns its key.
# OVERTALK_PRIVATEMODE_KEY_FILE=/run/secrets/privatemode-key
